            print(m[i][j], end=" ")
        print()
def max_niz(m):
    n = len(m)
    mx = None
    for i in range(n):
        for j in range(n):
            if i > j:
                if mx is None or m[i][j] > mx:
                    mx = m[i][j]
    return mx
def summa(m, mx):
    n = len(m)
    s = 0
    fl = False
    for i in range(n):
        for j in range(i, n):
            if mx is None or m[i][j] > mx:
                s += m[i][j]
                fl = True
    return s, fl

